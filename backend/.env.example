PORT=4000

# CORS — comma-separated origins, or leave blank for "*"
# CORS_ORIGIN=https://scanner.vercel.app

# --- Auth (leave ACCESS_CODE blank to disable auth entirely) ---
# Shared passcode all users must enter on the login screen.
ACCESS_CODE=secret-123

# Long random string used to sign session tokens. Required if ACCESS_CODE is set.
AUTH_SECRET="change-me-to-a-long-random-string"

# Comma-separated names with admin access (can view /api/usage).
ADMIN_NAMES=santosh
